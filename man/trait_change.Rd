\itemize{
\item \code{sorting}: \eqn{\sum_S \Delta p_j z_{j0}}{sum_S dp_j z_j0}, over the species \eqn{S}{S}
present at both steps;
\item \code{turnover}: \eqn{\sum_{gained} p_{j1} z_{j1} - \sum_{lost} p_{j0} z_{j0}}{sum_gained p_j1
